# Backend
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Supabase/Postgres example: postgresql+asyncpg://user:password@host:6543/postgres
SECRET_KEY=generate-a-fernet-key-with-python-cryptography
CORS_ORIGINS=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379/0

# Ollama (usato solo se AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AI Provider — ollama | groq | gemini
# Groq: gratis, OpenAI-compatible. Registrati su console.groq.com per l'API key.
# Gemini: gratis (tier generoso). API key da aistudio.google.com
AI_PROVIDER=ollama
AI_API_KEY=
# Lascia vuoto per usare il modello default del provider (Groq: llama-3.3-70b-versatile, Gemini: gemini-2.0-flash)
AI_MODEL=
# Lascia vuoto per usare l'endpoint default del provider (solo per Groq/provider OpenAI-compatible)
AI_BASE_URL=
# Override system prompt. Lascia vuoto per usare il default ottimizzato.
AI_SYSTEM_PROMPT=
# Temperatura sampling. Più bassa = messaggi più consistenti. Consigliato: 0.35
AI_TEMPERATURE=0.35

# Timing defaults
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=480
SESSION_MIN_MESSAGES=10
SESSION_MAX_MESSAGES=20
SESSION_BREAK_MIN_MINUTES=30
SESSION_BREAK_MAX_MINUTES=60
ACTIVE_HOURS_START=8
ACTIVE_HOURS_END=23

# Account defaults
DEFAULT_DAILY_LIMIT=20
# Cap anti-ban: lookup user_info/giorno per account durante lo scraping (override per-campagna)
SCRAPE_DAILY_LIMIT=180
WARMUP_ENABLED=true
MAX_CONCURRENT_BROWSERS=3

# Warm-up curve — DM/giorno per warmup_day. Formato "giorno_inizio-giorno_fine:limite,..."
# Range inclusivi. warmup_day=0 = warm-up finito (usa limite campagna).
# Default: giorni 1-3 → 5 DM, giorni 4-7 → 12 DM, giorni 8-14 → 20 DM.
WARMUP_LIMITS=1-3:5,4-7:12,8-14:20

# Cap hard per età account (giorni dalla creazione riga DB). Formato "soglia:limite,..."
# Cumulativo: vince ultima soglia raggiunta. "none" = nessun cap.
# Bypassato se account ha già inviato >= PROVEN_ACCOUNT_THRESHOLD messaggi totali.
# Default: giorni 0-2 → 0 DM (solo browsing), 3-6 → 3 DM, 7-13 → 8 DM, 14+ → nessun cap.
AGE_BASED_CAPS=0:0,3:3,7:8,14:none

# Soglia messaggi totali oltre la quale l'account è "rodato" → cap età disattivato.
# Protegge account IG vecchi aggiunti di recente al bot.
PROVEN_ACCOUNT_THRESHOLD=30

# Browser
BROWSER_PROFILES_DIR=./data/browser_profiles
HEADLESS=true

# JWT auth (multi-user). Lascia VUOTO per disabilitare auth (modalità single-user legacy).
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# Durata token in minuti. Default: 7 giorni.
JWT_EXPIRES_MINUTES=10080

# Chiave HMAC per gli pseudonimi dei numeri (canale WhatsApp).
# Generare con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NON ruotare senza una migrazione dei phone_hmac esistenti.
PHONE_HMAC_KEY=

# Telegram notifications (opzionale). Entrambi i campi devono essere settati per attivare.
# Token bot: parla con @BotFather su Telegram. chat_id: parla con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_POLL_TIMEOUT_SECONDS=5
TELEGRAM_SESSION_RECAP_ENABLED=true

# Auth login rate limit
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_TRUST_FORWARDED_FOR=false

# Anomaly detector — auto-pausa campagne/account su pattern critici.
ANOMALY_AUTO_STOP_ENABLED=true
ANOMALY_BAN_THRESHOLD_PER_HOUR=3
ANOMALY_CONSECUTIVE_DM_FAILURES=5
ANOMALY_CHALLENGE_THRESHOLD_PER_DAY=3
ANOMALY_WORKER_CRASH_THRESHOLD_PER_HOUR=3

# --- Canale WhatsApp: ingest e campagne (M2) --------------------------
WA_INGEST_DEFAULT_COUNTRY=39
WA_INGEST_MAX_ROWS=5000
WA_INGEST_MAX_ATTRS_BYTES=2048

# --- Canale WhatsApp: invio (M3) --------------------------------------
# Master switch fail-closed: nessun invio finche' non lo si accende a mano.
WA_SEND_ENABLED=false
WA_DAILY_CAP_DEFAULT=20
WA_WARMUP_STEPS=20,20,30,40,60,80,100
# Interruttore della rampa. Default del codice: false (spenta) dal 12/08.
# Mancava da questo file, ed e' il motivo per cui la decisione "rampa spenta"
# viveva solo nell'.env della macchina di Tommaso: ogni albero nuovo copiava
# l'esempio, non trovava la riga, e girava con la rampa accesa.
WA_WARMUP_ENABLED=false
WA_SEND_DELAY_MEDIAN_S=90
WA_SEND_DELAY_SIGMA=0.7
WA_SESSION_MIN_MSG=8
WA_SESSION_MAX_MSG=15
WA_BREAK_MIN_MIN=20
WA_BREAK_MAX_MIN=40
WA_ACTIVE_HOURS=09:00-20:00
# Finestra del browser di INVIO. true = invisibile, ed e' il default: il worker
# gira per giorni senza nessuno davanti. Si mette a false per guardare un
# collaudo con i propri occhi, poi si rimette. HEADLESS (quello generico) NON
# vale per l'invio: e' questo il campo.
WA_SEND_HEADLESS=true
WA_RESYNC_QUARANTINE_MIN=15
WA_GUARD_TAIL_N=40
WA_GUARD_HISTORY_MIN=80
WA_LOCK_TIMEOUT_MIN=20
WA_MAX_FAILURES_PER_CONTACT=3
# Un solo gradino di rampa al giorno. 0 o meno congela la rampa senza dirlo.
WA_WARMUP_ADVANCE_STEPS_PER_DAY=1
# STOP automatico: match su queste parole => opt-out immediato, senza umani.
# 'basta' NON sta qui (fix G6): da sola vuol dire "smettila", dentro una frase
# lunga quasi mai. Sta fra le ambigue qui sotto, che avvisano un umano invece
# di decidere da sole. Rimettercela riapre il bug.
WA_STOP_WORDS=stop,cancellami,non scrivermi,unsubscribe,rimuovimi
WA_STOP_WORDS_AMBIGUE=basta
WA_GLOBAL_DAILY_CAP=200
# PHONE_HMAC_KEY esiste gia' da M1: non duplicare.

# --- Canale WhatsApp: reply-watcher + opt-out (M4) --------------------
# TTL del lucchetto Redis sul profilo Chromium. Copre una mini-sessione di
# invio nel caso peggiore con ampio margine; la difesa vera sono comunque
# l'heartbeat e il cap wall-clock del loop di invio.
WA_PROFILE_LOCK_TTL_MIN=90
# Quanto aspetta un job di invio che trova il profilo occupato prima di
# riprovare (health-check o scansione risposte in corso).
WA_LOCK_BUSY_RETRY_S=90
# Per quanti giorni dopo l'ultimo invio un numero resta scansionabile, cosi'
# da catturare le risposte tardive alle campagne a un solo messaggio.
WA_REPLY_SCAN_WINDOW_DAYS=3
# Dopo quanti minuti un lucchetto profilo senza segni di vita e' considerato
# orfano e viene rilasciato dal cron.
WA_PROFILE_LOCK_STALE_MIN=90
# Circuit breaker sul tasso di opt-out: sopra soglia ferma l'INTERO canale,
# non solo la campagna (un tasso alto e' un segnale sul numero). Sotto il
# minimo di invii resta muto: su pochi invii la percentuale e' rumore.
WA_OPTOUT_BREAKER_MIN_INVII=10
WA_OPTOUT_BREAKER_PCT=25.0
# Dead-man's switch: URL di un servizio esterno (es. healthchecks.io) che si
# aspetta un ping ogni 5 minuti. VUOTO = disabilitato, ed e' il default: se
# il PC si spegne di notte con una campagna in corso, senza questo URL non
# se ne accorge nessuno. Non e' un gate di invio, e' sorveglianza esterna --
# l'unica cosa che un processo morto non puo' fare e' avvisare di esserlo.
WA_DEADMAN_PING_URL=
